  "descriptions": {
    "diffusion_transport_reaction": [
      "扩散、输运与反应",
      "描述热量、物质或种群密度在二维区域中的扩散、定向输运及局部增长或衰减。包括线性扩散、非线性扩散、退化扩散与反应—扩散—对流结构。"
    ],
    "elliptic_stationary": [
      "稳态场与椭圆方程",
      "描述达到平衡后的空间分布，例如稳态温度、势场、受迫场及非线性平衡态。这里的两个独立空间坐标均有来源依据，不将一维时间演化公式改称二维稳态。"
    ],
    "chemical_reaction_diffusion": [
      "化学反应、酶动力学与反应扩散",
      "描述多种反应物或化学组分在扩散过程中的转化、消耗与生成，包括质量作用反应、激活—抑制、酶促反应和分层耦合反应结构。"
    ],
    "chemotaxis_haptotaxis_signalling": [
      "趋化、趋触与信号传递",
      "描述细胞或其他移动群体沿化学信号、组织基质梯度迁移，以及信号产生、消耗和间接传递。不同信号弛豫或组织响应产生不同的演化与代数方程组合。"
    ],
    "population_ecology_cross_diffusion": [
      "种群竞争、捕食与交叉扩散",
      "描述物种间竞争、合作、捕食、资源利用及搜索—处理过程。交叉扩散或趋性项表示一种群的移动受到其他种群分布影响。"
    ],
    "epidemic_spread": [
      "传染病空间传播",
      "描述易感、暴露、感染或恢复人群在空间中的迁移及状态转化，覆盖普通扩散与交叉扩散传播结构。具体分量数依原模型保留。"
    ],
    "tumor_growth_and_virotherapy": [
      "肿瘤相场与溶瘤病毒治疗",
      "描述肿瘤与健康组织的相分离、营养物质交换，或病毒感染肿瘤细胞及组织降解。包括含化学势代数关系的相场系统。"
    ],
    "neuronal_memristive_dynamics": [
