    ],
    "quantum_and_complex_waves": [
      "复振幅、量子波与凝聚态",
      "描述复波函数或振幅的色散、非线性、自洽势和耗散耦合。原复变量展开为实部与虚部后再统计标量变量数。"
    ],
    "compressible_and_surface_fluid_waves": [
      "可压缩流动、浅水与色散水波",
      "描述密度或自由表面与水平速度的耦合、旋转效应和长波色散，也包括二维黏性Burgers结构。所列模型与Cylinder目标不可压缩NS系统有实质结构差异。"
    ],
    "integrable_dispersive_waves": [
      "可积与色散波动",
      "描述二维非线性波传播、弱横向效应及色散或耗散修正，覆盖KP类、Pavlov等源二维结构；没有给一维波动方程补加空间坐标。"
    ],
    "pattern_forming_higher_order_pdes": [
